' Read-only curated audit triage. Historical observations never imply current status.
Import helper_runtime

Private Function TextOf(value As JSONItem) As String
    Return value.AsString().Or("")
End Function

Private Function Has(values As Array Of String, value As String) As Boolean
    For Each entry As String In values
        If entry = value Then Return True
    Next
    Return False
End Function

Private Function Required(row As JSONItem, key As String) As String
    Dim value As JSONItem = row.Value(key)
    If Not value.IsString() Or String.Trim(TextOf(value)) = "" Then Throw New RuntimeException("nonempty string required: " + key)
    Return TextOf(value)
End Function

Private Function Canonical(filename As String) As String
    Return String.Trim(helper_runtime.Capture("realpath -e -- " + helper_runtime.Q(filename)))
End Function

Private Function Source(root As String, name As String, cache As JSONItem, isEvidence As Boolean = False) As JSONItem
    ' Deliberate allowlist: adding coverage is an explicit review, not filesystem discovery.
    Dim allowed As Boolean = Has(["app-workflow-gaps.json", "collection-gaps.json", "data-format-gaps.json", "opportunities-cli.json"], name)
    If isEvidence And Has(["takeover-triage-reconciliation.json"], name) Then allowed = True
    If Not allowed Then Throw New RuntimeException("source outside curated inventory: " + name)
    If Not cache.HasKey(name) Then
        Dim filename As String = root + "/tests/workspace-audit/" + name
        Dim resolved As String = Canonical(filename)
        If Not String.StartsWith(resolved, root + "/tests/workspace-audit/", True) Then Throw New RuntimeException("source escapes audit directory: " + name)
        cache.Value(name) = Json.Parse(helper_runtime.ReadText(resolved))
    End If
    Return cache.Value(name)
End Function

Private Function Pointer(document As JSONItem, pointerText As String) As JSONItem
    If pointerText = "" Then Return document
    If Not String.StartsWith(pointerText, "/", True) Then Throw New RuntimeException("JSON pointer must begin with /")
    Dim current As JSONItem = document
    Dim tokens As Array Of String = String.Split(String.Substring(pointerText, 1), "/")
    For Each encoded As String In tokens
        Dim token As String = ""
        Dim i As Integer = 0
        While i < String.Len(encoded)
            Dim ch As String = String.Substring(encoded, i, 1)
            If ch = "~" Then
                i += 1
                If i >= String.Len(encoded) Then Throw New RuntimeException("invalid JSON pointer escape")
                ch = String.Substring(encoded, i, 1)
                If ch = "0" Then
                    ch = "~"
                ElseIf ch = "1" Then
                    ch = "/"
                Else
                    Throw New RuntimeException("invalid JSON pointer escape")
                End If
            End If
            token += ch
            i += 1
        End While
        If current.IsObject() Then
            If Not current.HasKey(token) Then Throw New RuntimeException("unresolved JSON pointer: " + pointerText)
            current = current.Value(token)
        ElseIf current.IsArray() Then
            If token = "" Or (String.Len(token) > 1 And String.StartsWith(token, "0", True)) Then Throw New RuntimeException("invalid JSON pointer array index")
            Dim index As Integer = 0
            For Each digit As String In String.Chars(token)
                Dim position As Integer = String.IndexOf("0123456789", digit)
                If position < 0 Or index > current.Count() Then Throw New RuntimeException("invalid JSON pointer array index")
                index = index * 10 + position
            Next
            If index >= current.Count() Then Throw New RuntimeException("JSON pointer array index out of range")
            current = current.ValueAt(index)
        Else
            Throw New RuntimeException("JSON pointer traverses scalar")
        End If
    Next
    Return current
End Function

Private Function Reference(root As String, ref As JSONItem, cache As JSONItem, isEvidence As Boolean = False) As JSONItem
    If Not ref.IsObject() Then Throw New RuntimeException("reference must be an object")
    Dim name As String = Required(ref, "file")
    If Not ref.Value("pointer").IsString() Then Throw New RuntimeException("reference pointer must be a string")
    Return Pointer(Source(root, name, cache, isEvidence), TextOf(ref.Value("pointer")))
End Function

Private Function Inventory(root As String) As JSONItem
    Dim filename As String = Canonical(root + "/tests/workspace-audit/findings-index.json")
    If Not String.StartsWith(filename, root + "/tests/workspace-audit/", True) Then Throw New RuntimeException("manifest escapes audit directory")
    Dim index As JSONItem = Json.Parse(helper_runtime.ReadText(filename))
    If Not index.IsObject() Or Not index.Value("schema_version").IsNumber() Or index.Value("schema_version").AsNumber().Or(0.0) <> 1.0 Then Throw New RuntimeException("expected findings schema_version 1")
    If Required(index, "coverage") <> "curated-not-exhaustive" Then Throw New RuntimeException("coverage must be curated-not-exhaustive")
    Dim rows As JSONItem = index.Value("findings")
    If Not rows.IsArray() Then Throw New RuntimeException("findings must be an array")
    Dim ids As Array Of String = []
    Dim cache As JSONItem = JSONItem.NewObject()
    For i As Integer = 0 To rows.Count() - 1
        Dim row As JSONItem = rows.ValueAt(i)
        If Not row.IsObject() Then Throw New RuntimeException("finding must be an object")
        Dim id As String = Required(row, "id")
        For Each ch As String In String.Chars(id)
            If String.IndexOf("abcdefghijklmnopqrstuvwxyz0123456789-", ch) < 0 Then Throw New RuntimeException("invalid finding ID: " + id)
        Next
        If Has(ids, id) Then Throw New RuntimeException("duplicate finding ID: " + id)
        Array.Append(ids, id)
        Dim title As String = Required(row, "title")
        Dim status As String = Required(row, "status")
        If Not Has(["open", "resolved", "needs-review"], status) Then Throw New RuntimeException("invalid finding status: " + status)
        Dim rationale As String = Required(row, "rationale")
        Dim observation As JSONItem = Reference(root, row.Value("source"), cache)
        If Not observation.IsObject() Then Throw New RuntimeException("finding observation must be an object")
        If observation.HasKey("id") And TextOf(observation.Value("id")) <> id Then Throw New RuntimeException("source ID mismatch: " + id)
        Dim evidence As JSONItem = row.Value("evidence")
        If Not evidence.IsArray() Then Throw New RuntimeException("evidence must be an array")
        If status <> "needs-review" And evidence.Count() = 0 Then Throw New RuntimeException("triaged finding requires evidence: " + id)
        For j As Integer = 0 To evidence.Count() - 1
            Dim checked As JSONItem = Reference(root, evidence.ValueAt(j), cache, True)
            If checked.IsNull() Then Throw New RuntimeException("evidence cannot be null")
        Next
        row.Value("observation") = observation
    Next
    Return index
End Function

Function Main(args As Array Of String) As Integer
    Try
        Dim root As String = ""
        Dim command As String = ""
        Dim id As String = ""
        Dim status As String = ""
        Dim asJson As Boolean = False
        Dim seen As Array Of String = []
        Dim i As Integer = 1
        While i < args.Count
            Dim arg As String = args(i)
            If arg = "--help" Or arg = "-h" Then
                Print "Usage: audit_findings [--root PATH] list [--status open|resolved|needs-review] [--json]"
                Print "       audit_findings [--root PATH] show ID [--json]"
                Print "Read-only curated inventory, not an exhaustive audit. Historical prose never determines status."
                Print "Order follows the manifest. show/JSON includes original observations and explicit triage evidence."
                Print "Requires GNU realpath. Invalid input exits 2 with no partial output."
                Return 0
            ElseIf arg = "--root" Or arg = "--status" Or arg = "--json" Then
                If Has(seen, arg) Then Throw New RuntimeException("duplicate option: " + arg)
                Array.Append(seen, arg)
                If arg = "--json" Then
                    asJson = True
                Else
                    i += 1
                    If i >= args.Count Or String.StartsWith(args(i), "--", True) Then Throw New RuntimeException("missing value for " + arg)
                    If arg = "--root" Then root = args(i)
                    If arg = "--status" Then status = args(i)
                End If
            ElseIf String.StartsWith(arg, "-", True) Then
                Throw New RuntimeException("unknown option: " + arg)
            ElseIf command = "" Then
                command = arg
            ElseIf id = "" Then
                id = arg
            Else
                Throw New RuntimeException("unexpected argument: " + arg)
            End If
            i += 1
        End While
        If Not Has(["list", "show"], command) Then Throw New RuntimeException("expected list or show")
        If command = "list" And id <> "" Then Throw New RuntimeException("list takes no ID")
        If command = "show" And (id = "" Or Has(seen, "--status")) Then Throw New RuntimeException("show requires ID and accepts no status filter")
        If Has(seen, "--status") And Not Has(["open", "resolved", "needs-review"], status) Then Throw New RuntimeException("invalid status filter: " + status)
        If root = "" Then root = helper_runtime.WorkspaceRoot()
        root = Canonical(root)
        Dim index As JSONItem = Inventory(root)
        Dim selected As JSONItem = JSONItem.NewArray()
        Dim rows As JSONItem = index.Value("findings")
        For j As Integer = 0 To rows.Count() - 1
            Dim row As JSONItem = rows.ValueAt(j)
            If (command = "list" And (status = "" Or TextOf(row.Value("status")) = status)) Or (command = "show" And TextOf(row.Value("id")) = id) Then selected.Add(row)
        Next
        If command = "show" And selected.Count() = 0 Then Throw New RuntimeException("unknown finding ID: " + id)
        index.Value("findings") = selected
        If asJson Then
            Print Json.Stringify(index)
        Else
            Print "Curated inventory; not exhaustive. Status is explicit triage, never inferred from historical prose."
            For j As Integer = 0 To selected.Count() - 1
                Dim row As JSONItem = selected.ValueAt(j)
                Print TextOf(row.Value("id")) + "\t" + TextOf(row.Value("status")) + "\t" + TextOf(row.Value("title"))
                If command = "show" Then
                    Print "Rationale: " + TextOf(row.Value("rationale"))
                    Print "Source: " + Json.Stringify(row.Value("source"))
                    Print "Observation: " + Json.Stringify(row.Value("observation"))
                    Print "Evidence: " + Json.Stringify(row.Value("evidence"))
                End If
            Next
        End If
        Return 0
    Catch e As Exception
        StdErr.WriteLine("audit_findings: " + e.Message)
        Return 2
    End Try
End Function
