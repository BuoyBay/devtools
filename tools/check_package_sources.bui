' Compare source inputs with sealed packages; native ABI is intentionally excluded.
Import helper_runtime
Import Zip.Zip
Package Crypto

' POSIX helper: readlink distinguishes directory symlinks without following them.
#If Not TargetWindows Then
Private Declare Function ReadLink Lib "c" Alias "readlink" (filePath As String, buffer As Ptr, size As Integer) As Integer

#End If

Function IsDirectoryLink(item As FileSystemItem) As Boolean
    #If TargetWindows Then
        Throw New RuntimeException("Package source comparison requires POSIX readlink")
    #Else
    Dim buffer As Bytes = Bytes.FromString("x", Text.Encodings.UTF8)
    Return ReadLink(item.FullPath(), buffer.DataPtr(), buffer.Count) >= 0
    #End If
End Function

Function ReadBytes(filename As String) As Bytes
    Dim opened As Result Of BinaryStream, IOError = BinaryStream.Open(New FileSystemItem(filename), False)
    If opened.IsErr Then Throw New Exception("Cannot read " + filename)
    Dim stream As BinaryStream = opened.Value
    Try
        Return stream.Read(stream.Length)
    Finally
        stream.Close()
    End Try
End Function

Function SameJSON(a As JSONItem, b As JSONItem) As Boolean
    If a.IsObject() <> b.IsObject() Or a.IsArray() <> b.IsArray() Then Return False
    If a.IsObject() Then
        If a.Count() <> b.Count() Then Return False
        For Each key As String In a.Keys()
            If Not b.HasKey(key) Then Return False
            If Not SameJSON(a.Value(key), b.Value(key)) Then Return False
        Next
        Return True
    End If
    If a.IsArray() Then
        If a.Count() <> b.Count() Then Return False
        For i As Integer = 0 To a.Count() - 1
            If Not SameJSON(a.ValueAt(i), b.ValueAt(i)) Then Return False
        Next
        Return True
    End If
    ' Python JSON equality treats booleans as the numeric values zero and one.
    If (a.IsBoolean() And b.IsNumber()) Or (a.IsNumber() And b.IsBoolean()) Then
        Dim left As Double = a.AsNumber().Or(0.0)
        Dim right As Double = b.AsNumber().Or(0.0)
        If a.AsBoolean().Or(False) Then left = 1.0
        If b.AsBoolean().Or(False) Then right = 1.0
        Return left = right
    End If
    Return Json.Stringify(a) = Json.Stringify(b)
End Function

Sub Issue(record As JSONItem, kind As String, relative As String, field As String = "", message As String = "")
    Dim finding As JSONItem = JSONItem.NewObject()
    finding.Value("kind") = kind
    finding.Value("path") = relative
    If field <> "" Then finding.Value("field") = field
    If message <> "" Then finding.Value("message") = message
    record.Value("issues").Add(finding)
End Sub

Function Contains(items As Array Of String, value As String) As Boolean
    For Each item As String In items
        If String.Compare(item, value, True) = 0 Then Return True
    Next
    Return False
End Function

Sub Collect(folder As FileSystemItem, prefix As String, files As Array Of String)
    If Not folder.IsFolder() Then Return
    For Each item As FileSystemItem In folder.Children()
        Dim relative As String = prefix + item.Name()
        If item.IsFile() Then
            Array.Append(files, relative)
        ElseIf item.IsFolder() And Not IsDirectoryLink(item) Then
            Collect(item, relative + "/", files)
        End If
    Next
End Sub

Function EntryBytes(reader As ZipReader, name As String, duplicates As Boolean = False) As Bytes
    If duplicates Then
        Dim last As Bytes = Nil
        Dim more As Boolean = reader.GotoFirstEntry()
        While more
            Dim entry As ZipEntry = reader.CurrentEntry
            If String.Compare(entry.Name, name, True) = 0 Then
                Dim found As Optional Of Bytes = reader.ExtractCurrentEntryToBytes()
                If Not found.HasValue Then Throw New Exception("Cannot read archive entry " + name)
                last = found.Value
            End If
            more = reader.GotoNextEntry()
        End While
        If last = Nil Then Throw New Exception("Missing archive entry " + name)
        Return last
    End If
    If Not reader.LocateEntry(name, False) Then Throw New Exception("Missing archive entry " + name)
    Dim data As Optional Of Bytes = reader.ExtractCurrentEntryToBytes()
    If Not data.HasValue Then Throw New Exception("Cannot read archive entry " + name)
    Return data.Value
End Function

Function ValidPart(value As String) As Boolean
    Return value <> "" And value <> "." And value <> ".." And String.InStr(value, "/") = 0 And String.InStr(value, "\\") = 0
End Function

Sub CheckPackage(root As String, sourceRoot As String, source As String, record As JSONItem)
    Dim base As String = Path.Join(sourceRoot, source)
    Dim metadata As JSONItem = Json.Parse(helper_runtime.ReadText(Path.Join(base, "manifest.json")))
    If Not metadata.IsObject() Then Throw New Exception("Source manifest must be an object")
    Dim name As String = metadata.Value("name").AsString().Or("")
    Dim version As String = metadata.Value("version").AsString().Or("")
    If Not ValidPart(name) Or Not ValidPart(version) Then Throw New Exception("invalid package name/version")
    Dim archive As String = "packages/" + name + "-" + version + ".buipkg"
    record.Value("name") = name
    record.Value("version") = version
    record.Value("archive") = archive
    If Not New FileSystemItem(Path.Join(root, archive)).IsFile() Then
        Issue(record, "missing_archive", archive)
        Return
    End If
    Dim opened As Result Of ZipReader, ZipError = ZipReader.Open(Path.Join(root, archive))
    If opened.IsErr Then Throw New Exception(opened.Error.Message)
    Dim reader As ZipReader = opened.Value
    Try
        Dim names As Array Of String = []
        Dim actual As Array Of String = []
        Dim duplicate As Boolean = False
        Dim more As Boolean = reader.GotoFirstEntry()
        While more
            Dim entry As ZipEntry = reader.CurrentEntry
            Dim relative As String = entry.Name
            If Contains(names, relative) Then
                duplicate = True
            Else
                Array.Append(names, relative)
                If (String.StartsWith(relative, "modules/", True) Or String.StartsWith(relative, "resources/", True)) And Not String.EndsWith(relative, "/", True) Then Array.Append(actual, relative)
            End If
            more = reader.GotoNextEntry()
        End While
        If duplicate Then Issue(record, "duplicate_archive_entries", archive)
        Dim sealed As JSONItem
        Try
            sealed = Json.Parse(EntryBytes(reader, "manifest.json", duplicate).ToString(Text.Encodings.UTF8))
            If Not sealed.IsObject() Then Throw New Exception("Archive manifest must be an object")
        Catch error As Exception
            Issue(record, "invalid_package", archive + "!manifest.json", "", error.Message)
            Return
        End Try
        For Each key As String In metadata.Keys()
            If Not SameJSON(metadata.Value(key), sealed.Value(key)) Then Issue(record, "manifest_mismatch", "manifest.json", key)
        Next
        Dim expected As Array Of String = []
        Collect(New FileSystemItem(Path.Join(base, "modules")), "modules/", expected)
        Collect(New FileSystemItem(Path.Join(base, "resources")), "resources/", expected)
        Array.Sort(expected)
        Array.Sort(actual)
        For Each relative As String In expected
            If Not Contains(actual, relative) Then
                Issue(record, "missing_file", relative)
            ElseIf EntryBytes(reader, relative, duplicate).ToHex() <> ReadBytes(Path.Join(base, relative)).ToHex() Then
                Issue(record, "content_mismatch", relative)
            End If
        Next
        For Each relative As String In actual
            If Contains(expected, relative) Then Continue For
            If name = "compressionkit" And relative = "resources/backend.json" Then
                Dim receipt As JSONItem = Json.Parse(EntryBytes(reader, relative, duplicate).ToString(Text.Encodings.UTF8))
                Dim inputs As Array Of String = [Path.Join(base, "native/bridge.c"), Path.Join(base, "native/zlib-1.3.2.tar.gz"), Path.Join(base, "native/sources.json"), Path.Join(sourceRoot, "tools/build_compressionkit.py")]
                Dim available As Boolean = True
                For Each input As String In inputs
                    If Not New FileSystemItem(input).IsFile() Then available = False
                Next
                If available Then
                    Dim data As New Bytes()
                    For Each input As String In inputs
                        data.Append(ReadBytes(input))
                    Next
                    Dim digest As String = Crypto.Hash(Crypto.HashAlgorithms.SHA256, data).ToHex()
                    If receipt.Value("nativeSourceSha256").AsString().Or("") <> digest Then Issue(record, "generated_receipt_mismatch", relative)
                End If
                If Not receipt.Value("targets").IsArray() Or receipt.Value("targets").Count() = 0 Then Issue(record, "invalid_generated_receipt", relative)
            Else
                Issue(record, "extra_file", relative)
            End If
        Next
        Dim fields As Array Of String = ["modules", "resources"]
        For Each field As String In fields
            Dim declared As JSONItem = sealed.Value(field)
            If declared.IsNull() Then Continue For
            Dim matching As Array Of String = []
            For Each relative As String In actual
                If String.StartsWith(relative, field + "/", True) Then Array.Append(matching, relative)
            Next
            Dim listed As Array Of String = []
            Dim valid As Boolean = declared.IsArray()
            For i As Integer = 0 To declared.Count() - 1
                Dim member As JSONItem = declared.ValueAt(i)
                ' Python set(declared) rejects arrays/objects as unhashable.
                If declared.IsArray() And (member.IsObject() Or member.IsArray()) Then Throw New Exception("unhashable manifest file list entry")
                Dim value As String = member.AsString().Or("")
                If Not Contains(matching, value) Then valid = False
                If Not Contains(listed, value) Then Array.Append(listed, value)
            Next
            If Array.Count(listed) <> Array.Count(matching) Then valid = False
            If Not valid Then Issue(record, "manifest_file_list_mismatch", "manifest.json", field)
        Next
    Finally
        reader.Close()
    End Try
    Dim mirror As String = "dist/" + name + "-" + version + ".buipkg"
    If New FileSystemItem(Path.Join(root, mirror)).IsFile() Then
        If ReadBytes(Path.Join(root, mirror)).ToHex() <> ReadBytes(Path.Join(root, archive)).ToHex() Then Issue(record, "mirror_mismatch", mirror)
    End If
End Sub

Function Main(args As Array Of String) As Integer
    Try
        Dim root As String = ""
        Dim output As String = ""
        Dim sourceRef As String = ""
        Dim hasSourceRef As Boolean = False
        Dim showJSON As Boolean = False
        Dim i As Integer = 1
        While i < Array.Count(args)
            Select Case args(i)
            Case "--json"
                showJSON = True
            Case "--root", "--output", "--source-ref"
                Dim optionName As String = args(i)
                i += 1
                If i >= Array.Count(args) Then Throw New Exception("Missing value for " + optionName)
                If optionName = "--root" Then
                    root = args(i)
                ElseIf optionName = "--output" Then
                    output = args(i)
                Else
                    sourceRef = args(i)
                    hasSourceRef = True
                End If
            Case "--help", "-h"
                Print "Usage: check_package_sources.bui [--root PATH] [--json] [--output PATH] [--source-ref REF]"
                Return 0
            Case Else
                Throw New Exception("Unknown option: " + args(i))
            End Select
            i += 1
        End While
        If root = "" Then root = helper_runtime.WorkspaceRoot()
        Dim sourceRoot As String = root
        Dim commit As String = ""
        If hasSourceRef Then
            If sourceRef = "" Then Throw New Exception("source ref must be nonempty")
            sourceRoot = helper_runtime.TempDirectory("package-source-ref-")
            Try
                Dim helper As String = System.EnvironmentVariable("BUOY_PACKAGE_SOURCE_SNAPSHOT_HELPER").Or("")
                If helper = "" Then helper = Path.Join(helper_runtime.WorkspaceRoot(), "tools/package_source_snapshot.py")
                commit = String.Trim(helper_runtime.Capture("python3 " + helper_runtime.Q(helper) + " --root " + helper_runtime.Q(root) + " --source-ref " + helper_runtime.Q(sourceRef) + " --output " + helper_runtime.Q(sourceRoot), "", 120000))
            Catch error As Exception
                helper_runtime.RemoveTree(sourceRoot)
                Throw error
            End Try
        End If
        Try
        Dim report As JSONItem = JSONItem.NewObject()
        Dim packages As JSONItem = JSONItem.NewArray()
        Dim sources As Array Of String = []
        Dim folder As New FileSystemItem(Path.Join(sourceRoot, "libraries"))
        If folder.IsFolder() Then
            For Each item As FileSystemItem In folder.Children()
                If item.IsFolder() And item.Child("manifest.json").IsFile() Then Array.Append(sources, "libraries/" + item.Name())
            Next
        End If
        Array.Sort(sources)
        Dim count As Integer = 0
        For Each source As String In sources
            Dim record As JSONItem = JSONItem.NewObject()
            record.Value("source") = source
            record.Value("issues") = JSONItem.NewArray()
            packages.Add(record)
            Try
                CheckPackage(root, sourceRoot, source, record)
            Catch error As Exception
                Issue(record, "invalid_package", source + "/manifest.json", "", error.Message)
            End Try
            count += record.Value("issues").Count()
            If Not showJSON Then
                For j As Integer = 0 To record.Value("issues").Count() - 1
                    Dim finding As JSONItem = record.Value("issues").ValueAt(j)
                    Dim message As String = finding.Value("message").AsString().Or("")
                    If message <> "" Then message = ": " + message
                    Print source + ": " + finding.Value("kind").AsString().Or("") + ": " + finding.Value("path").AsString().Or("") + message
                Next
            End If
        Next
        report.Value("schema") = 1
        report.Value("scope") = "Source metadata, module/resource bytes and existing dist mirrors; native ABI excluded."
        report.Value("packages_checked") = packages.Count()
        report.Value("issue_count") = count
        report.Value("packages") = packages
        If hasSourceRef Then
            Dim provenance As JSONItem = JSONItem.NewObject()
            provenance.Value("requested") = sourceRef
            provenance.Value("commit") = commit
            provenance.Value("archive_origin") = "worktree"
            report.Value("source_ref") = provenance
        End If
        Dim rendered As String = Json.Stringify(report) + "\n"
        If output <> "" Then
            helper_runtime.MakeDirectory(New FileSystemItem(output).Parent.FullPath())
            helper_runtime.WriteText(output, rendered)
        End If
        If showJSON Then
            StdOut.Write(rendered)
        Else
            Print Str(packages.Count()) + " packages; " + Str(count) + " issues"
        End If
        If count > 0 Then Return 1
        Return 0
        Finally
            If hasSourceRef Then helper_runtime.RemoveTree(sourceRoot)
        End Try
    Catch error As Exception
        StdErr.WriteLine("check_package_sources: " + error.Message)
        Return 2
    End Try
End Function
