' Offline documentation discovery. All parsing/rendering/indexing runs in Buoy.
Import "buoydev/Common"
Import regex.Regex
Import zip.Zip

Import crypto.Crypto
Function ParseJSON(source As String, integralSchema As Boolean = False) As JSONItem
    Dim data As Bytes = Bytes.FromString(source, Text.Encodings.UTF8)
    DevNeed(data.Count <= 128 * MiB, "JSON exceeds 128 MiB")
    Dim frames As Array Of JSONItem = []
    Dim i As Integer = 0
    While i < data.Count
        Dim ch As Integer = data.Item(i)
        If ch = 123 Or ch = 91 Then
            Dim frame As JSONItem = JSONItem.NewObject()
            frame.Value("object") = ch = 123
            frame.Value("key") = True
            frame.Value("keys") = JSONItem.NewObject()
            Array.Append(frames, frame)
            DevNeed(frames.Count <= 128, "JSON nesting exceeds 128")
        ElseIf ch = 125 Or ch = 93 Then
            If frames.Count > 0 Then Array.RemoveAt(frames, frames.Count - 1)
        ElseIf ch = 44 Then
            If frames.Count > 0 Then frames(frames.Count - 1).Value("key") = True
        ElseIf ch = 34 Then
            Dim start As Integer = i
            i += 1
            While i < data.Count
                If data.Item(i) = 34 Then Exit While
                If data.Item(i) = 92 Then
                    If i + 5 < data.Count Then DevNeed(String.SubstringBytes(source, i, 6) <> "\\u0000", "NUL is unsupported by Buoy strings")
                    i += 1
                End If
                i += 1
            End While
            If frames.Count > 0 Then
                Dim frame As JSONItem = frames(frames.Count - 1)
                If frame.Value("object").AsBoolean().Or(False) And frame.Value("key").AsBoolean().Or(False) Then
                    Dim key As String = Json.Parse(String.SubstringBytes(source, start, i - start + 1)).AsString().Value
                    Dim keys As JSONItem = frame.Value("keys")
                    DevNeed(Not keys.HasKey(key), "duplicate JSON key: " + key)
                    keys.Value(key) = True
                    frame.Value("key") = False
                    frame.Value("schema") = key = "schema"
                End If
            End If
        ElseIf integralSchema And frames.Count = 1 And (ch >= 48 And ch <= 57) Then
            If frames(0).Value("schema").AsBoolean().Or(False) Then
                Dim ending As Integer = i
                While ending < data.Count
                    Dim nextByte As Integer = data.Item(ending)
                    If nextByte = 44 Or nextByte = 125 Or nextByte <= 32 Then Exit While
                    ending += 1
                End While
                DevNeed(Match(String.SubstringBytes(source, i, ending - i), "^[0-9]+$"), "invalid manifest schema")
                i = ending - 1
            End If
        ElseIf ch = 78 Or ch = 73 Or ch = 45 Then
            Dim word As String = String.SubstringBytes(source, i, 9)
            For Each invalid As String In ["NaN", "Infinity", "-Infinity"]
                If String.StartsWith(word, invalid, True) Then Throw New InvalidArgumentException("invalid JSON number: " + invalid)
            Next
        End If
        i += 1
    End While
    Return Json.Parse(source)
End Function

Const DocsPrefix As String = "resources/buoy-docs/"
Const MiB As Integer = 1048576

Class RegexCache
    Public Shared Property Values As Map Of String, Regex = New Map Of String, Regex()
End Class

Function RX(pattern As String) As Regex
    Dim existing As Optional Of Regex = RegexCache.Values.Get(pattern)
    If existing.HasValue Then Return existing.Value
    Dim compiled As Result Of Regex, RegexError = Regex.Compile("(*UCP)" + pattern)
    DevNeed(compiled.IsOk, "invalid regular expression: " + pattern)
    RegexCache.Values.Set(pattern, compiled.Value)
    Return compiled.Value
End Function

Function Match(inputText As String, pattern As String) As Boolean
    Return RX(pattern).Find(inputText).HasValue
End Function

Function Replace(inputText As String, pattern As String, replacement As String) As String
    Return RX(pattern).ReplaceAll(inputText, replacement)
End Function

Function Hex4(number As Integer) As String
    Dim output As String = ""
    Dim digits As String = "0123456789abcdef"
    For i As Integer = 0 To 3
        output = String.Substring(digits, number Mod 16, 1) + output
        number = number \ 16
    Next
    Return "\\u" + output
End Function

Function Serialize(value As JSONItem) As String
    Dim source As String = Json.Stringify(value)
    Dim data As Bytes = Bytes.FromString(source, Text.Encodings.UTF8)
    Dim output As New Bytes
    Dim i As Integer = 0
    Dim quoted As Boolean = False
    Dim escaped As Boolean = False
    While i < data.Count
        Dim firstByte As Integer = data.Item(i)
        If firstByte < 128 Then
            If firstByte = 34 And Not escaped Then quoted = Not quoted
            If firstByte = 92 And quoted Then
                escaped = Not escaped
            Else
                escaped = False
            End If
            output.Append(firstByte)
            If Not quoted And (firstByte = 44 Or firstByte = 58) Then output.Append(32)
            i += 1
            Continue While
        End If
        Dim codepoint As Integer
        Dim width As Integer
        If firstByte < 224 Then
            width = 2
            codepoint = firstByte And 31
        ElseIf firstByte < 240 Then
            width = 3
            codepoint = firstByte And 15
        Else
            width = 4
            codepoint = firstByte And 7
        End If
        For j As Integer = 1 To width - 1
            codepoint = codepoint * 64 + (data.Item(i + j) And 63)
        Next
        If codepoint <= 65535 Then
            output.Append(Bytes.FromString(Hex4(codepoint), Text.Encodings.UTF8))
        Else
            codepoint -= 65536
            output.Append(Bytes.FromString(Hex4(55296 + codepoint \ 1024) + Hex4(56320 + codepoint Mod 1024), Text.Encodings.UTF8))
        End If
        i += width
    End While
    Return output.ToString(Text.Encodings.UTF8)
End Function

Function S(value As JSONItem, key As String, fallback As String = "") As String
    Return value.Value(key).AsString().Or(fallback)
End Function

Function Escape(inputText As String) As String
    inputText = String.Replace(inputText, "&", "&amp;")
    inputText = String.Replace(inputText, "<", "&lt;")
    inputText = String.Replace(inputText, ">", "&gt;")
    inputText = String.Replace(inputText, "\"", "&quot;")
    Return String.Replace(inputText, "'", "&#x27;")
End Function


