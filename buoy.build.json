        "fuzzyfind",
        "modelkit",
        "chatgptauth",
        "keychain",
        "secretstore",
        "maskkit",
        "controlsnapshot"
      ],
      "argv": [
        "{python}",
        "tools/build_studio.py",
        "--output",
        "{root}/dist/build/studio/{target}/{profile}/BuoyStudio{application-suffix}",
        "--sealed-packages-only",
        "--profile",
        "{profile}"
      ],
      "check_argv": [
        "{python}",
        "tools/build_studio.py",
        "--check-only",
        "--sealed-packages-only",
        "--profile",
        "{profile}"
      ],
      "check_all_targets": true,
      "inputs": [
        "tools/build_studio.py",
        "tools/development_permissions.py",
        "apps/shared/development/*.bui",
        "apps/BuoyStudio/*.bui",
        "apps/BuoyStudio/StudioShellTerminal.c",
        "apps/BuoyStudio/documentation.html",
        "apps/BuoyDocs/snapshot/docs.json",
        "apps/shared/snippets/*.bui",
        "containers/integrations/treeview/*.bui",
        "containers/integrations/searchfield/*.bui",
        "containers/integrations/segmentedbutton/*.bui",
        "containers/integrations/contextmenu/*.bui",
        "containers/integrations/textinput/*.bui",
        "tools/build_gtklifecycle.py",
        "libraries/gtklifecycle/native/*",
        "tools/studio_build_info.py",
        "tools/studio_debug_adapter.py",
        "tools/discover_layout_packages.py",
        "tools/discover_documentation.py",
        "apps/BuoyStudio/resources/*.*",
        "apps/BuoyStudio/resources/glyphs/*.png",
        "apps/BuoyStudio/resources/glyphs/*.ico"
      ],
      "outputs": [
        "dist/build/studio/{target}/{profile}"
      ],
      "timeout": 1800
    },
